---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import Loop from '../components/Loop.astro';
import Day from '../components/Day.astro';
import Features from '../components/Features.astro';
import Companion from '../components/Companion.astro';
import Science from '../components/Science.astro';
import Friends from '../components/Friends.astro';
import Privacy from '../components/Privacy.astro';
import Maker from '../components/Maker.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
---
<Layout>
  <Nav />

  <main id="top">
    <Hero />
    <Problem />
    <Loop />
    <Day />
    <Features />
    <Companion />
    <Science />
    <Friends />
    <Privacy />
    <Maker />
    <Faq />
    <Cta />
  </main>

  <Footer />

  <script src="../scripts/main.js"></script>
</Layout>
